// RestoControl Production Schema - Prisma ORM 6.19.3
// Engine: PostgreSQL 16.15 | Multi-Tenant Architecture
// NO-REFUND Policy (16 Models, 12 Enums)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// ENUMS (12 Enums - Strict NO-REFUND Architecture)
// -----------------------------------------------------------------------------

enum ShiftStatus {
  ACTIVE
  OFF_DUTY
  ON_BREAK
}

enum TableStatus {
  AVAILABLE
  BUSY
  OCCUPIED
  RESERVED
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum OrderSource {
  QR
  POS
  ONLINE
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED
}

enum OrderItemStatus {
  PENDING
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum InvoiceStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  KHQR
  DIGITAL_WALLET
}

enum PaymentAttemptStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  CORRECTED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

// -----------------------------------------------------------------------------
// 1. TENANCY & ACCESS CONTROL (6 Models)
// -----------------------------------------------------------------------------

model Restaurant {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String   @db.VarChar(100)
  slug              String   @unique @db.VarChar(60)
  phoneNumber       String?  @db.VarChar(30)
  email             String?  @db.VarChar(120)
  address           String?  @db.Text
  logoUrl           String?  @db.VarChar(500)
  logoPublicId      String?  @db.VarChar(120)
  primaryCurrency   String   @default("USD") @db.VarChar(3)
  secondaryCurrency String?  @default("KHR") @db.VarChar(3)
  exchangeRate      Decimal  @default(4100.0000) @db.Decimal(12, 4)
  taxRate           Decimal  @default(0.00) @db.Decimal(5, 2)
  serviceChargeRate Decimal  @default(0.00) @db.Decimal(5, 2)
  language          String   @default("en") @db.VarChar(5)
  openingHours      Json?    @db.JsonB
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)

  users         User[]
  roles         Role[]
  staffProfiles StaffProfile[]
  categories    Category[]
  products      Product[]
  tables        Table[]
  tableSessions TableSession[]
  customers     Customer[]
  orders        Order[]
  orderItems    OrderItem[]
  transactions  Transaction[]
  payments      Payment[]
  auditLogs     AuditLog[]

  @@map("restaurants")
}

model User {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId   String    @db.Uuid
  roleId         String    @db.Uuid
  name           String    @db.VarChar(100)
  email          String    @unique @db.VarChar(120)
  passwordHash   String    @db.VarChar(255)
  phone          String?   @db.VarChar(30)
  avatarUrl      String?   @db.VarChar(500)
  avatarPublicId String?   @db.VarChar(120)
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime? @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt      DateTime? @db.Timestamptz(6)

  restaurant     Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  role           Role           @relation(fields: [roleId, restaurantId], references: [id, restaurantId], onDelete: Restrict)
  staffProfile   StaffProfile?
  openedSessions TableSession[] @relation("SessionOpenedBy")
  closedSessions TableSession[] @relation("SessionClosedBy")
  createdOrders  Order[]        @relation("OrderCreatedBy")
  transactions   Transaction[]  @relation("TransactionCashier")
  payments       Payment[]      @relation("PaymentProcessedBy")
  auditLogs      AuditLog[]

  @@unique([id, restaurantId])
  @@index([restaurantId, isActive])
  @@map("users")
}

model Role {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId String   @db.Uuid
  name         String   @db.VarChar(50)
  displayName  String   @db.VarChar(100)
  description  String?  @db.VarChar(255)
  isSystem     Boolean  @default(false)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  restaurant  Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  users       User[]
  permissions RolePermission[]

  @@unique([id, restaurantId])
  @@unique([restaurantId, name])
  @@map("roles")
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(60)
  module      String   @db.VarChar(50)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  restaurantId String   @db.Uuid
  assignedAt   DateTime @default(now()) @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId, restaurantId], references: [id, restaurantId], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([restaurantId, roleId])
  @@map("role_permissions")
}

model StaffProfile {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String      @unique @db.Uuid
  restaurantId     String      @db.Uuid
  employeeCode     String      @db.VarChar(30)
  pinHash          String?     @db.VarChar(255)
  shiftStatus      ShiftStatus @default(OFF_DUTY)
  hourlyRate       Decimal?    @db.Decimal(10, 2)
  emergencyContact String?     @db.VarChar(120)
  createdAt        DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime    @updatedAt @db.Timestamptz(6)

  user       User       @relation(fields: [userId, restaurantId], references: [id, restaurantId], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)

  @@unique([userId, restaurantId])
  @@unique([id, restaurantId])
  @@unique([restaurantId, employeeCode])
  @@index([restaurantId, shiftStatus])
  @@map("staff_profiles")
}

// -----------------------------------------------------------------------------
// 2. CATALOG & FLOOR MANAGEMENT (5 Models)
// -----------------------------------------------------------------------------

model Category {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId String   @db.Uuid
  name         String   @db.VarChar(60)
  icon         String?  @db.VarChar(50)
  color        String?  @db.VarChar(20)
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  products   Product[]

  @@unique([id, restaurantId])
  @@unique([restaurantId, name])
  @@index([restaurantId, isActive, sortOrder])
  @@map("categories")
}

model Product {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId   String    @db.Uuid
  categoryId     String    @db.Uuid
  name           String    @db.VarChar(120)
  description    String?   @db.Text
  price          Decimal   @db.Decimal(10, 2)
  costPrice      Decimal?  @db.Decimal(10, 2)
  stockQuantity  Int       @default(0)
  trackStock     Boolean   @default(false)
  isAvailable    Boolean   @default(true)
  isPopular      Boolean   @default(false)
  imageUrl       String?   @db.VarChar(500)
  imagePublicId  String?   @db.VarChar(120)
  prepTime       Int?      @default(15)
  kitchenStation String?   @db.VarChar(50)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt      DateTime? @db.Timestamptz(6)

  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  category   Category    @relation(fields: [categoryId, restaurantId], references: [id, restaurantId], onDelete: Restrict)
  orderItems OrderItem[]

  @@unique([id, restaurantId])
  @@index([restaurantId, categoryId, isAvailable])
  @@index([restaurantId, isPopular])
  @@map("products")
}

model Table {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId   String      @db.Uuid
  legacyId       String?     @db.VarChar(50)
  name           String      @db.VarChar(50)
  section        String      @default("Main Dining") @db.VarChar(60)
  seats          Int         @default(4)
  status         TableStatus @default(AVAILABLE)
  qrCodeKey      String      @unique @db.VarChar(64)
  qrCodeUrl      String?     @db.VarChar(500)
  isActive       Boolean     @default(false)
  totalAmount    Decimal     @default(0.00) @db.Decimal(10, 2)
  lastActivityAt DateTime?   @db.Timestamptz(6)
  createdAt      DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(6)
  deletedAt      DateTime?   @db.Timestamptz(6)

  restaurant Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  sessions   TableSession[]

  @@unique([id, restaurantId])
  @@unique([restaurantId, name])
  @@index([restaurantId, status])
  @@map("tables")
}

model TableSession {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId        String        @db.Uuid
  tableId             String        @db.Uuid
  sessionNumber       String        @db.VarChar(35)
  status              SessionStatus @default(ACTIVE)
  covers              Int           @default(1)
  openedAt            DateTime      @default(now()) @db.Timestamptz(6)
  closedAt            DateTime?     @db.Timestamptz(6)
  openedById          String?       @db.Uuid
  closedById          String?       @db.Uuid
  subtotal            Decimal       @default(0.00) @db.Decimal(10, 2)
  taxAmount           Decimal       @default(0.00) @db.Decimal(10, 2)
  serviceChargeAmount Decimal       @default(0.00) @db.Decimal(10, 2)
  discountAmount      Decimal       @default(0.00) @db.Decimal(10, 2)
  totalAmount         Decimal       @default(0.00) @db.Decimal(10, 2)
  paidAmount          Decimal       @default(0.00) @db.Decimal(10, 2)
  notes               String?       @db.Text
  createdAt           DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime      @updatedAt @db.Timestamptz(6)

  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  table        Table         @relation(fields: [tableId, restaurantId], references: [id, restaurantId], onDelete: Restrict)
  openedBy     User?         @relation("SessionOpenedBy", fields: [openedById, restaurantId], references: [id, restaurantId], onDelete: Restrict)
  closedBy     User?         @relation("SessionClosedBy", fields: [closedById, restaurantId], references: [id, restaurantId], onDelete: Restrict)
  orders       Order[]
  transactions Transaction[]

  @@unique([id, restaurantId])
  @@unique([restaurantId, sessionNumber])
  @@index([restaurantId, tableId, status])
  @@map("table_sessions")
}

model Customer {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId String    @db.Uuid
  name         String    @db.VarChar(100)
  phone        String?   @db.VarChar(30)
  email        String?   @db.VarChar(120)
  notes        String?   @db.Text
  totalVisits  Int       @default(0)
  totalSpent   Decimal   @default(0.00) @db.Decimal(10, 2)
  lastVisitAt  DateTime? @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6)

  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  orders       Order[]
  transactions Transaction[]

  @@unique([id, restaurantId])
  @@index([restaurantId, phone])
  @@map("customers")
}

// -----------------------------------------------------------------------------
// 3. ORDER PROCESSING (2 Models)
// -----------------------------------------------------------------------------

model Order {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId        String        @db.Uuid
  sessionId           String?       @db.Uuid
  customerId          String?       @db.Uuid
  createdById         String?       @db.Uuid
  orderNumber         String        @db.VarChar(30)
  idempotencyKey      String?       @db.VarChar(64)
  source              OrderSource   @default(POS)
  orderType           OrderType     @default(DINE_IN)
  status              OrderStatus   @default(PENDING)
  paymentStatus       PaymentStatus @default(UNPAID)
  subtotal            Decimal       @default(0.00) @db.Decimal(10, 2)
  taxAmount           Decimal       @default(0.00) @db.Decimal(10, 2)
  serviceChargeAmount Decimal       @default(0.00) @db.Decimal(10, 2)
  discountType        DiscountType?
  discountRate        Decimal?      @db.Decimal(5, 2)
  discountAmount      Decimal       @default(0.00) @db.Decimal(10, 2)
  total               Decimal       @default(0.00) @db.Decimal(10, 2)
  notes               String?       @db.Text
  cancellationReason  String?       @db.Text
  cancelledAt         DateTime?     @db.Timestamptz(6)
  createdAt           DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime      @updatedAt @db.Timestamptz(6)

  restaurant         Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  session            TableSession? @relation(fields: [sessionId, restaurantId], references: [id, restaurantId], onDelete: Restrict)
  customer           Customer?     @relation(fields: [customerId, restaurantId], references: [id, restaurantId], onDelete: Restrict)
  createdBy          User?         @relation("OrderCreatedBy", fields: [createdById, restaurantId], references: [id, restaurantId], onDelete: Restrict)
  items              OrderItem[]
  directTransactions Transaction[] @relation("DirectOrderTransaction")

  @@unique([id, restaurantId])
  @@unique([restaurantId, orderNumber])
  @@unique([restaurantId, idempotencyKey])
  @@index([restaurantId, status])
  @@index([restaurantId, sessionId, paymentStatus])
  @@index([restaurantId, createdAt])
  @@map("orders")
}

model OrderItem {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId      String          @db.Uuid
  productId    String?         @db.Uuid
  restaurantId String          @db.Uuid
  productName  String          @db.VarChar(150)
  quantity     Int             @default(1)
  unitPrice    Decimal         @db.Decimal(10, 2)
  unitCost     Decimal?        @db.Decimal(10, 2)
  lineTotal    Decimal         @db.Decimal(10, 2)
  instructions String?         @db.VarChar(255)
  status       OrderItemStatus @default(PENDING)
  createdAt    DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime        @updatedAt @db.Timestamptz(6)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  order      Order      @relation(fields: [orderId, restaurantId], references: [id, restaurantId], onDelete: Cascade)
  product    Product?   @relation(fields: [productId, restaurantId], references: [id, restaurantId], onDelete: Restrict)

  @@unique([id, restaurantId])
  @@index([orderId, restaurantId])
  @@index([productId, restaurantId])
  @@map("order_items")
}

// -----------------------------------------------------------------------------
// 4. FINANCIAL LEDGER & AUDITING (3 Models)
// -----------------------------------------------------------------------------

model Transaction {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId        String        @db.Uuid
  sessionId           String?       @db.Uuid
  directOrderId       String?       @db.Uuid
  customerId          String?       @db.Uuid
  cashierId           String?       @db.Uuid
  transactionNumber   String        @db.VarChar(30)
  tableName           String?       @db.VarChar(50)
  orderType           OrderType     @default(DINE_IN)
  currency            String        @default("USD") @db.VarChar(3)
  subtotal            Decimal       @db.Decimal(10, 2)
  taxAmount           Decimal       @default(0.00) @db.Decimal(10, 2)
  serviceChargeAmount Decimal       @default(0.00) @db.Decimal(10, 2)
  discountType        DiscountType?
  discountRate        Decimal?      @db.Decimal(5, 2)
  discountAmount      Decimal       @default(0.00) @db.Decimal(10, 2)
  discountReason      String?       @db.VarChar(255)
  grossAmount         Decimal       @db.Decimal(10, 2)
  amountPaid          Decimal       @default(0.00) @db.Decimal(10, 2)
  writeOffAmount      Decimal       @default(0.00) @db.Decimal(10, 2)
  paymentStatus       PaymentStatus @default(UNPAID)
  status              InvoiceStatus @default(ACTIVE)
  isSplitPayment      Boolean       @default(false)
  paymentSummary      String        @default("") @db.VarChar(150)
  itemSummary         String?       @db.Text
  notes               String?       @db.Text
  completedAt         DateTime?     @db.Timestamptz(6)
  createdAt           DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime      @updatedAt @db.Timestamptz(6)

  restaurant  Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  session     TableSession? @relation(fields: [sessionId, restaurantId], references: [id, restaurantId], onDelete: Restrict)
  directOrder Order?        @relation("DirectOrderTransaction", fields: [directOrderId, restaurantId], references: [id, restaurantId], onDelete: Restrict)
  customer    Customer?     @relation(fields: [customerId, restaurantId], references: [id, restaurantId], onDelete: Restrict)
  cashier     User?         @relation("TransactionCashier", fields: [cashierId, restaurantId], references: [id, restaurantId], onDelete: Restrict)
  payments    Payment[]

  @@unique([id, restaurantId])
  @@unique([restaurantId, transactionNumber])
  @@index([sessionId, restaurantId])
  @@index([directOrderId, restaurantId])
  @@index([restaurantId, status])
  @@index([restaurantId, paymentStatus])
  @@index([restaurantId, completedAt])
  @@map("transactions")
}

model Payment {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId       String               @db.Uuid
  transactionId      String               @db.Uuid
  processedById      String?              @db.Uuid
  method             PaymentMethod        @default(CASH)
  status             PaymentAttemptStatus @default(PENDING)
  currency           String               @default("USD") @db.VarChar(3)
  amount             Decimal              @db.Decimal(10, 2)
  tenderCurrency     String               @default("USD") @db.VarChar(3)
  tenderAmount       Decimal              @db.Decimal(14, 2)
  exchangeRate       Decimal              @default(1.0000) @db.Decimal(12, 4)
  cashReceived       Decimal?             @db.Decimal(14, 2)
  changeGiven        Decimal?             @db.Decimal(14, 2)
  roundingAdjustment Decimal              @default(0.00) @db.Decimal(10, 2)
  gatewayReference   String?              @db.VarChar(100)
  idempotencyKey     String?              @unique @db.VarChar(64)
  failureReason      String?              @db.VarChar(255)
  paidAt             DateTime?            @db.Timestamptz(6)
  createdAt          DateTime             @default(now()) @db.Timestamptz(6)

  restaurant  Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  transaction Transaction @relation(fields: [transactionId, restaurantId], references: [id, restaurantId], onDelete: Restrict)
  processedBy User?       @relation("PaymentProcessedBy", fields: [processedById, restaurantId], references: [id, restaurantId], onDelete: Restrict)

  @@unique([id, restaurantId])
  @@index([restaurantId, transactionId])
  @@index([restaurantId, method, status])
  @@map("payments")
}

model AuditLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId String?  @db.Uuid
  userId       String?  @db.Uuid
  action       String   @db.VarChar(80)
  entityType   String   @db.VarChar(50)
  entityId     String?  @db.Uuid
  details      Json?    @db.JsonB
  ipAddress    String?  @db.VarChar(45)
  userAgent    String?  @db.VarChar(255)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  user       User?       @relation(fields: [userId, restaurantId], references: [id, restaurantId], onDelete: Restrict)

  @@index([restaurantId, entityType, entityId])
  @@index([restaurantId, createdAt])
  @@index([userId])
  @@map("audit_logs")
}
